## Django settings
SECRET_KEY=SOME_VERY_LONG_SECRET_KEY_CHANGE_IT_FOR_PRODUCTION
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

## SMTP settings for password recovery (Gmail requires an app password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Leave empty to use EMAIL_HOST_USER as the sender.
DEFAULT_FROM_EMAIL=
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_URL=http://localhost:5173/recuperar-senha

## Database settings (used only with production settings / DB2)
DB_DATABASE=
DB_HOST=
DB_PORT=50000
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=
